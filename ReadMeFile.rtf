\f0\b\fs24 \cf2 README
\f1\b0 \
	Codes for agro-ecological regions in Sri Lanka: Ampara (DZ), Kurunegala (IZ), and Ratnapura (WZ).\
\
\

\f0\b SCRIPTS
\f1\b0 \
  	The location is selected at the top of each script with location = 'ampara' / 'kuru' / 'rath' (switch case).\
\

\f0\b CODE_MCMC_and_BSI.m
\f1\b0 \
	Parameter estimation of the D-vine copula (DRAM) and BSI vs SSI index construction.\
      	Contains the functions marginals and Loglikelihood_location at the end of the file.\
\

\f0\b CODE_ContourPlots.m
\f1\b0 \
      	Contour plots of the fitted copula densities on the original scale: soil moisture vs temperature (XT), rainfall vs temperature (RT) and soil moisture vs rainfall (RX).\
\

\f0\b CODE_Forecasting.m
\f1\b0 \
      	SARIMA forecasting of rainfall, temperature and soil moisture: 1-month-ahead forecasts on the test period and forecasts for 2026. \
\
\

\f0\b DATA FILES (.mat)
\f1\b0 \
	Ampara\
      		rainfall_series_ampara.mat		rainfall (R)\
      		temp_series_ampara.mat       		temperature (T)\
      		sm_series_ampara.mat         		soil moisture (X)\
	\
	Kurunegala\
      		rainfall_series_kuru.mat    		rainfall (R)\
      		temp_series_kuru.mat         		temperature (T)\
     	 	sm_series_kuru.mat           		soil moisture (X)\
\
	Ratnapura\
      		rainfall_series_rath.mat     		rainfall (R)\
      		temp_series_rath.mat         		temperature (T)\
      		sm_series_rath.mat           		soil moisture (X)\
\
\
  	Posterior chains (after burn-in)\
     		 chain_post_ampara.mat\
      		chain_post_kuru.mat\
      		chain_post_rath.mat\
    \
\

